{
  "manifest_version": 3,
  "name": "Economics Journal Tags — TOP5 · FT50 · UTD24",
  "version": "1.0.0",
  "description": "在学术搜索结果中标记经济学 TOP5、FT50、UTD24 及自定义学校期刊等级。",
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "economics-journal-tags@jiandwei.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_title": "Economics Journal Tags",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://dblp.org/*",
        "*://dblp.uni-trier.de/*",
        "*://dblp2.uni-trier.de/*",
        "*://dblp.dagstuhl.de/*",
        "*://scholar.google.com/*",
        "*://scholar.google.com.hk/*",
        "*://scholar.google.co.uk/*",
        "*://scholar.google.com.au/*",
        "*://scholar.google.ca/*",
        "*://scholar.google.de/*",
        "*://scholar.google.fr/*",
        "*://scholar.google.co.jp/*",
        "*://scholar.google.co.in/*",
        "*://scholar.google.com.sg/*",
        "*://scholar.google.cn/*",
        "*://www.semanticscholar.org/*",
        "*://www.webofscience.com/*",
        "*://webofscience.clarivate.cn/*"
      ],
      "css": [
        "css/economics.css"
      ],
      "js": [
        "data/economicsJournals.js",
        "js/economics.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
